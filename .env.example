# GWAS PrePubMatch server configuration
# Copy to .env and adjust for your environment.

# Server bind (use 0.0.0.0 in Docker/production)
PREPUBMATCH_HOST=127.0.0.1
PREPUBMATCH_PORT=8000
PREPUBMATCH_WORKERS=1

# Comma-separated browser origins allowed by CORS
PREPUBMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# HTTP client
PREPUBMATCH_HTTP_TIMEOUT=20
PREPUBMATCH_HTTP_RETRIES=2
PREPUBMATCH_CACHE=true
PREPUBMATCH_CACHE_TTL_CATALOG=3600
PREPUBMATCH_CACHE_TTL_LITERATURE=7200

# Optional API keys (higher rate limits)
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.com
# NCBI_API_KEY=
